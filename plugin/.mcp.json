{
  "mcpServers": {
    "airplay": {
      "command": "uvx",
      "args": ["--from", "airplay-mcp[fairplay]==0.1.3", "airplay-mcp"],
      "env": {
        "AIRPLAY_RECEIVER": "${user_config.receiver}",
        "AIRPLAY_FP_EMU_DIR": "${user_config.fp_emu_dir}",
        "AIRPLAY_UXPLAY_PATH": "${user_config.uxplay_path}",
        "AIRPLAY_NAME": "${user_config.device_name}"
      }
    }
  }
}
